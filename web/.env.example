# Copy to .env.local if you need to override the committed mode files.
# Do not put secrets in this file. None of these values are credentials.

# development-adapter — in-process fixture store. No HTTP API is running.
# live — reserved for a verified backend. Requests fail until VITE_API_BASE_URL points at one.
VITE_API_MODE=development-adapter

# Used only when VITE_API_MODE=live. Leave empty. Do not invent a host.
VITE_API_BASE_URL=

# development — explicit development sign-in adapter (not production authentication).
# disabled — production authentication is not connected. Sign-in cannot create a session.
VITE_AUTH_MODE=development

# Development session length in milliseconds. This is not a security control.
VITE_DEV_SESSION_TTL_MS=1800000
