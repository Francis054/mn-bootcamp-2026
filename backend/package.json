{
  "name": "mn-bootcamp-api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API for the Maxim Nyansa 2026 Cybersecurity Bootcamp.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/database/cli-data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/database/cli-data-source.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/database/cli-data-source.ts",
    "admin:create": "tsx src/commands/admin-create.ts",
    "seed": "tsx src/commands/seed.ts",
    "timetable:import": "tsx src/commands/import-timetable.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
