# Copy to frontend/.env.local only if you need to override the defaults.
# Do not put secrets in this file. None of these values are credentials.

# Leave blank to call the API at the same origin under /api/v1.
# Set to true to use the in-browser fixture store for offline work.
# Production builds leave this unset.
VITE_USE_MOCK_API=

# Trainee sign-in, sign-up, and sign-out. Leave blank to hide them.
# Set to on, then rebuild and redeploy the website, to show them again.
# This is not a secret. Administrator sign-in does not use it.
VITE_TRAINEE_SELF_SERVICE=
